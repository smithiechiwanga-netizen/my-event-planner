
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#080b12">
<title>My Event Planner</title>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

<style>
:root {
  --blue:#0a84ff;
  --bg:#080b12;
  --card:#111827;
  --white:#fff;
  --muted:#9ca3af;
  --border:#263244;
}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--white);font-family:Arial,sans-serif}
button,input,textarea,select{font:inherit}
button{border:0;cursor:pointer;border-radius:8px;padding:11px 15px}
.primary{background:var(--blue);color:white}
.secondary{background:#263244;color:white}
.danger{background:#dc3545;color:white}
input,textarea,select{
 width:100%;padding:12px;margin:7px 0 14px;
 background:#080b12;color:white;border:1px solid var(--border);border-radius:8px
}
label{color:#cbd5e1;font-size:14px}
.container{max-width:1100px;margin:auto;padding:20px}
header{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;border-bottom:1px solid var(--border);padding-bottom:15px}
.logo{font-size:21px;font-weight:bold}
.logo span{color:var(--blue)}
.card{background:var(--card);border:1px solid var(--border);border-radius:12px;padding:18px;margin:15px 0}
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:20px}
.stat strong{display:block;font-size:27px;margin-top:10px}
.muted{color:var(--muted)}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:15px}
.event{background:#0b1220;border:1px solid var(--border);padding:15px;border-radius:10px;margin:12px 0}
.event h3{margin-top:0}
.actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}
.hidden{display:none!important}
.notice{margin:12px 0;color:#60a5fa}
#calendar{display:grid;grid-template-columns:repeat(7,1fr);gap:5px}
.day{min-height:75px;background:#0b1220;border:1px solid var(--border);border-radius:6px;padding:6px;font-size:12px;overflow-wrap:anywhere}
.day.today{border:2px solid var(--blue)}
.day small{display:block;color:#60a5fa;margin-top:5px}
#loginScreen{max-width:420px;margin:10vh auto;padding:20px}
footer{text-align:center;color:var(--muted);padding:25px}
@media(max-width:700px){
 .stats{grid-template-columns:repeat(2,1fr)}
 .grid{grid-template-columns:1fr}
 .container{padding:13px}
 header{align-items:flex-start}
}
</style>
</head>

<body>

<section id="loginScreen" class="card">
 <div class="logo">MY EVENT <span>PLANNER</span></div>
 <p class="muted">Your personal event management system.</p>
 <h2>Welcome Back</h2>
 <form id="loginForm">
  <label>Email address</label>
  <input id="email" type="email" required placeholder="Enter your email">
  <label>Password</label>
  <input id="password" type="password" required placeholder="Enter your password">
  <button class="primary" style="width:100%" type="submit">Login</button>
 </form>
 <p id="loginMessage" class="notice"></p>
</section>

<main id="app" class="hidden">
<div class="container">

<header>
 <div>
  <div class="logo">MY EVENT <span>PLANNER</span></div>
  <small class="muted">Organise your time. Manage your events.</small>
 </div>
 <button id="logoutBtn" class="secondary">Logout</button>
</header>

<h2>Dashboard</h2>
<p class="muted" id="todayDate"></p>

<section class="stats">
 <div class="card stat"><span class="muted">Total Events</span><strong id="total">0</strong></div>
 <div class="card stat"><span class="muted">Upcoming</span><strong id="upcoming">0</strong></div>
 <div class="card stat"><span class="muted">Completed</span><strong id="completed">0</strong></div>
 <div class="card stat"><span class="muted">Today</span><strong id="today">0</strong></div>
</section>

<div class="grid">
<section class="card">
 <h2 id="formHeading">Add New Event</h2>
 <form id="eventForm">
  <input type="hidden" id="eventId">
  <label>Event Title *</label>
  <input id="title" required placeholder="e.g. Birthday Celebration">
  <label>Location</label>
  <input id="location" placeholder="Event location">
  <label>Event Date *</label>
  <input id="eventDate" type="date" required>
  <label>Event Time</label>
  <input id="eventTime" type="time">
  <label>Description</label>
  <textarea id="description" rows="3" placeholder="Event details"></textarea>
  <button class="primary" type="submit" id="saveBtn">Save Event</button>
  <button class="secondary hidden" type="button" id="cancelEdit">Cancel</button>
 </form>
 <p id="eventMessage" class="notice"></p>
</section>

<section class="card">
 <h2>Next Upcoming Event</h2>
 <div id="nextEvent" class="muted">No upcoming events.</div>
 <hr style="border-color:var(--border);margin:20px 0">
 <h3>Upcoming Reminders</h3>
 <p class="muted">Upcoming events are listed here. Background notifications require a scheduled backend service.</p>
 <div id="reminders"></div>
</section>
</div>

<section class="card">
 <h2>My Events</h2>
 <input id="search" placeholder="Search events...">
 <select id="filter">
  <option value="all">All Events</option>
  <option value="upcoming">Upcoming Events</option>
  <option value="completed">Completed Events</option>
 </select>
 <div id="eventsList"></div>
</section>

<section class="card">
 <div style="display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap">
  <h2>Monthly Calendar</h2>
  <div class="actions">
   <button class="secondary" id="prevMonth">←</button>
   <button class="secondary" id="nextMonth">→</button>
  </div>
 </div>
 <h3 id="monthTitle"></h3>
 <div id="calendar"></div>
</section>

<footer>MY EVENT PLANNER · Personal Event Management</footer>
</div>
</main>

<script>
// SUPABASE CONFIGURATION
const SUPABASE_URL = "https://zcqikcidnucylhqpwdvk.supabase.co";
const SUPABASE_KEY = "sb_publishable_9ZLSGg4HxeUTgq1HG99hAQ_3npfjw0R";

const db = window.supabase.createClient(SUPABASE_URL,SUPABASE_KEY);

let events = [];
let currentMonth = new Date();
let loading = false;

const $ = id => document.getElementById(id);

function localDate(date=new Date()){
 const y=date.getFullYear();
 const m=String(date.getMonth()+1).padStart(2,"0");
 const d=String(date.getDate()).padStart(2,"0");
 return `${y}-${m}-${d}`;
}

function escapeHTML(value=""){
 return String(value).replace(/[&<>"']/g,char=>({
  "&":"&amp;","<":"&lt;",">":"&gt;",
  '"':"&quot;","'":"&#039;"
 })[char]);
}

function eventDateTime(event){
 return new Date(`${event.event_date}T${event.event_time||"23:59"}`);
}

function isCompleted(event){
 return eventDateTime(event)<new Date();
}

function showMessage(id,message){
 $(id).textContent=message;
}

async function loadEvents(){
 if(loading)return;
 loading=true;

 const {data,error}=await db.from("events")
  .select("*").order("event_date",{ascending:true});

 loading=false;

 if(error){
  showMessage("eventMessage",error.message);
  return;
 }

 events=data||[];
 render();
}

function render(){
 const now=new Date();
 const todayString=localDate(now);
 const upcoming=events.filter(e=>!isCompleted(e));
 const completed=events.filter(isCompleted);
 const todayEvents=events.filter(e=>e.event_date===todayString);

 $("total").textContent=events.length;
 $("upcoming").textContent=upcoming.length;
 $("completed").textContent=completed.length;
 $("today").textContent=todayEvents.length;

 $("todayDate").textContent=now.toLocaleDateString(undefined,{
  weekday:"long",year:"numeric",month:"long",day:"numeric"
 });

 const next=upcoming[0];

 $("nextEvent").innerHTML=next
  ?`<h3>${escapeHTML(next.title)}</h3>
    <p>${escapeHTML(next.event_date)} ${escapeHTML(next.event_time||"")}</p>
    <p>${escapeHTML(next.location||"No location specified")}</p>`
  :"No upcoming events.";

 $("reminders").innerHTML=upcoming.slice(0,5).map(e=>
  `<p>• ${escapeHTML(e.title)} — ${escapeHTML(e.event_date)}</p>`
 ).join("")||'<p class="muted">No upcoming reminders.</p>';

 renderEvents();
 renderCalendar();
}

function renderEvents(){
 const query=$("search").value.toLowerCase();
 const filter=$("filter").value;

 const filtered=events.filter(e=>{
  const matches=[e.title,e.location,e.description]
   .some(v=>(v||"").toLowerCase().includes(query));
  const status=isCompleted(e);

  return matches&&(
   filter==="all"||
   (filter==="completed"&&status)||
   (filter==="upcoming"&&!status)
  );
 });

 $("eventsList").innerHTML=filtered.length
 ?filtered.map(e=>`
  <article class="event">
   <h3>${escapeHTML(e.title)}</h3>
   <p>📅 ${escapeHTML(e.event_date)} ${escapeHTML(e.event_time||"")}</p>
   <p>📍 ${escapeHTML(e.location||"No location")}</p>
   <p>${escapeHTML(e.description||"No description")}</p>
   <p class="muted">${isCompleted(e)?"Completed":"Upcoming"}</p>
   <div class="actions">
    <button class="primary" onclick="editEvent('${e.id}')">Edit</button>
    <button class="danger" onclick="deleteEvent('${e.id}')">Delete</button>
   </div>
  </article>`).join("")
 :'<p class="muted">No events found.</p>';
}

$("eventForm").addEventListener("submit",async e=>{
 e.preventDefault();

 const id=$("eventId").value;
 const {data:{user}}=await db.auth.getUser();

 if(!user){
  showMessage("eventMessage","Please login again.");
  return;
 }

 const payload={
  title:$("title").value.trim(),
  location:$("location").value.trim(),
  event_date:$("eventDate").value,
  event_time:$("eventTime").value||null,
  description:$("description").value.trim(),
  user_id:user.id
 };

 if(!payload.title||!payload.event_date)return;

 const request=id
  ?db.from("events").update(payload).eq("id",id)
  :db.from("events").insert(payload);

 const {error}=await request;

 if(error){
  showMessage("eventMessage",error.message);
  return;
 }

 showMessage("eventMessage",id?"Event updated!":"Event saved!");
 resetForm();
 await loadEvents();
});

function editEvent(id){
 const event=events.find(e=>e.id===id);
 if(!event)return;

 $("eventId").value=event.id;
 $("title").value=event.title;
 $("location").value=event.location||"";
 $("eventDate").value=event.event_date;
 $("eventTime").value=event.event_time||"";
 $("description").value=event.description||"";

 $("formHeading").textContent="Edit Event";
 $("saveBtn").textContent="Update Event";
 $("cancelEdit").classList.remove("hidden");
 window.scrollTo({top:0,behavior:"smooth"});
}

async function deleteEvent(id){
 if(!confirm("Are you sure you want to delete this event?"))return;

 const {error}=await db.from("events").delete().eq("id",id);

 if(error){
  alert(error.message);
  return;
 }

 await loadEvents();
}

function resetForm(){
 $("eventForm").reset();
 $("eventId").value="";
 $("formHeading").textContent="Add New Event";
 $("saveBtn").textContent="Save Event";
 $("cancelEdit").classList.add("hidden");
}

$("cancelEdit").addEventListener("click",resetForm);
$("search").addEventListener("input",renderEvents);
$("filter").addEventListener("change",renderEvents);

function renderCalendar(){
 const year=currentMonth.getFullYear();
 const month=currentMonth.getMonth();
 const first=new Date(year,month,1).getDay();
 const days=new Date(year,month+1,0).getDate();

 $("monthTitle").textContent=currentMonth.toLocaleDateString(undefined,{
  month:"long",year:"numeric"
 });

 const names=["Sun","Mon","Tue","Wed","Thu","Fri","Sat"];
 let html=names.map(n=>
  `<div class="muted" style="text-align:center;padding:7px">${n}</div>`
 ).join("");

 for(let i=0;i<first;i++)html+="<div></div>";

 for(let day=1;day<=days;day++){
  const date=`${year}-${String(month+1).padStart(2,"0")}-${String(day).padStart(2,"0")}`;
  const matching=events.filter(e=>e.event_date===date);
  const todayClass=date===localDate()?"today":"";

  html+=`<div class="day ${todayClass}">
   <strong>${day}</strong>
   ${matching.map(e=>`<small>${escapeHTML(e.title)}</small>`).join("")}
  </div>`;
 }

 $("calendar").innerHTML=html;
}

$("prevMonth").addEventListener("click",()=>{
 currentMonth.setMonth(currentMonth.getMonth()-1);
 renderCalendar();
});

$("nextMonth").addEventListener("click",()=>{
 currentMonth.setMonth(currentMonth.getMonth()+1);
 renderCalendar();
});

async function showDashboard(){
 $("loginScreen").classList.add("hidden");
 $("app").classList.remove("hidden");
 await loadEvents();
}

async function showLogin(){
 $("app").classList.add("hidden");
 $("loginScreen").classList.remove("hidden");
}

$("loginForm").addEventListener("submit",async e=>{
 e.preventDefault();
 showMessage("loginMessage","Signing in...");

 const {error}=await db.auth.signInWithPassword({
  email:$("email").value.trim(),
  password:$("password").value
 });

 if(error){
  showMessage("loginMessage",error.message);
  return;
 }

 showMessage("loginMessage","");
 await showDashboard();
});

$("logoutBtn").addEventListener("click",async()=>{
 await db.auth.signOut();
 await showLogin();
});

async function initialize(){
 const {data:{session}}=await db.auth.getSession();

 if(session)await showDashboard();
 else await showLogin();
}

db.auth.onAuthStateChange((event,session)=>{
 if(event==="SIGNED_OUT")showLogin();
});

initialize();
</script>
</body>
</html>
